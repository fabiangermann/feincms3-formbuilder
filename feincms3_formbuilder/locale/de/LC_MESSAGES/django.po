#: conditionals.py:228
#, python-format
msgid "Field '%(field)s' is configured to depend on itself."
msgstr "Das Feld '%(field)s' ist so konfiguriert, dass es von sich selbst abhängt."

#: conditionals.py:238
#, python-format
msgid "Field '%(field)s' depends on '%(control)s', which doesn't exist."
msgstr "Das Feld '%(field)s' hängt von '%(control)s' ab, das nicht existiert."

#: conditionals.py:248
#, python-format
msgid ""
"Field '%(field)s' depends on '%(control)s', which is not a dropdown or a "
"radio field."
msgstr "Das Feld '%(field)s' hängt von '%(control)s' ab, das kein Dropdown- oder Radio-Feld ist."

#: conditionals.py:260
#, python-format
msgid ""
"Field '%(field)s' depends on '%(control)s', which is itself conditional. "
"Chained conditions are not supported."
msgstr "Das Feld '%(field)s' hängt von '%(control)s' ab, das selbst eine Bedingung hat. Verkettete Bedingungen werden nicht unterstützt."

#: conditionals.py:271
#, python-format
msgid ""
"Field '%(field)s' depends on '%(control)s', which is asked on a later step. "
"It would never be shown."
msgstr "Das Feld '%(field)s' hängt von '%(control)s' ab, das erst in einem späteren Schritt abgefragt wird. Es würde nie angezeigt."

#: conditionals.py:281
#, python-format
msgid "Field '%(field)s' has a controlling field but no values."
msgstr "Das Feld '%(field)s' hat ein steuerndes Feld, aber keine Werte."

#: conditionals.py:294
#, python-format
msgid ""
"Field '%(field)s' is shown for %(values)s, which '%(control)s' doesn't "
"offer. Valid values: %(keys)s."
msgstr "Das Feld '%(field)s' wird bei %(values)s angezeigt, was '%(control)s' nicht anbietet. Gültige Werte: %(keys)s."

#: models.py:35
#, python-format
msgid "%(value)s is not a valid region key identifier."
msgstr "%(value)s ist kein gültiger identifier"

#: models.py:58
msgid "show when field"
msgstr "anzeigen, wenn Feld"

#: models.py:62
msgid ""
"Name of the dropdown or radio field controlling this field. Leave empty to "
"always show this field."
msgstr ""
"Name des Dropdown- oder Radio-Felds, das dieses Feld steuert. Leer lassen, "
"um dieses Feld immer anzuzeigen."

#: models.py:67
msgid "show when values"
msgstr "anzeigen bei Werten"

#: models.py:70
msgid ""
"One choice value (key) of the controlling field per line. This field is "
"shown when the controlling field's answer is one of them."
msgstr ""
"Ein Auswahlwert (Schlüssel) des steuernden Felds pro Zeile. Dieses Feld wird "
"angezeigt, wenn die Antwort im steuernden Feld einem davon entspricht."

