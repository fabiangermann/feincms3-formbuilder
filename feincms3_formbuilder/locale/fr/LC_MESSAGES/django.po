#: conditionals.py:228
#, python-format
msgid "Field '%(field)s' is configured to depend on itself."
msgstr "Le champ '%(field)s' est configuré pour dépendre de lui-même."

#: conditionals.py:238
#, python-format
msgid "Field '%(field)s' depends on '%(control)s', which doesn't exist."
msgstr "Le champ '%(field)s' dépend de '%(control)s', qui n'existe pas."

#: conditionals.py:248
#, python-format
msgid ""
"Field '%(field)s' depends on '%(control)s', which is not a dropdown or a "
"radio field."
msgstr "Le champ '%(field)s' dépend de '%(control)s', qui n'est ni une liste déroulante ni un champ de boutons radio."

#: conditionals.py:260
#, python-format
msgid ""
"Field '%(field)s' depends on '%(control)s', which is itself conditional. "
"Chained conditions are not supported."
msgstr "Le champ '%(field)s' dépend de '%(control)s', qui est lui-même conditionnel. Les conditions en chaîne ne sont pas prises en charge."

#: conditionals.py:271
#, python-format
msgid ""
"Field '%(field)s' depends on '%(control)s', which is asked on a later step. "
"It would never be shown."
msgstr "Le champ '%(field)s' dépend de '%(control)s', qui est demandé à une étape ultérieure. Il ne serait jamais affiché."

#: conditionals.py:281
#, python-format
msgid "Field '%(field)s' has a controlling field but no values."
msgstr "Le champ '%(field)s' a un champ de contrôle mais aucune valeur."

#: conditionals.py:294
#, python-format
msgid ""
"Field '%(field)s' is shown for %(values)s, which '%(control)s' doesn't "
"offer. Valid values: %(keys)s."
msgstr "Le champ '%(field)s' est affiché pour %(values)s, que '%(control)s' ne propose pas. Valeurs valides : %(keys)s."

#: models.py:35
#, python-format
msgid "%(value)s is not a valid region key identifier."
msgstr "%(value)s n'est pas un identifiant de clé de région valide."

#: models.py:58
msgid "show when field"
msgstr "afficher si le champ"

#: models.py:62
msgid ""
"Name of the dropdown or radio field controlling this field. Leave empty to "
"always show this field."
msgstr ""
"Nom du champ de liste déroulante ou de boutons radio qui contrôle ce champ. "
"Laisser vide pour toujours afficher ce champ."

#: models.py:67
msgid "show when values"
msgstr "afficher pour les valeurs"

#: models.py:70
msgid ""
"One choice value (key) of the controlling field per line. This field is "
"shown when the controlling field's answer is one of them."
msgstr ""
"Une valeur de choix (clé) du champ de contrôle par ligne. Ce champ est "
"affiché lorsque la réponse au champ de contrôle correspond à l'une d'elles."

